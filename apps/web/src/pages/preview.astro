---
/**
 * Payload Live Preview endpoint.
 *
 * Rendered on demand (never prerendered) so the Payload admin can load it in an
 * iframe and stream draft edits into it. Access is gated by PREVIEW_SECRET and
 * drafts are read with a Payload API key (PAYLOAD_API_TOKEN) so unpublished
 * content is visible. Pages render through the same BlockRenderer used by the
 * live site; posts render their rich-text body.
 */
export const prerender = false;

import SiteLayout from '~/layouts/SiteLayout.astro';
import BlockRenderer from '~/components/blocks/BlockRenderer.astro';
import { richTextToHtml } from '~/lib/richtext';
import { getServerUrl } from '~/lib/env';

const { searchParams } = new URL(Astro.request.url);
const secret = searchParams.get('secret') ?? '';
const collection = searchParams.get('collection') === 'posts' ? 'posts' : 'pages';
const slug = searchParams.get('slug') ?? 'home';

const previewSecret = process.env.PREVIEW_SECRET ?? '';
if (!previewSecret || secret !== previewSecret) {
  return new Response('Unauthorized', { status: 401 });
}

const serverUrl = getServerUrl();
const apiKey = process.env.PAYLOAD_API_TOKEN ?? '';

let doc: Record<string, any> | null = null;
try {
  const url = new URL(`${serverUrl}/api/${collection}`);
  url.searchParams.set('where[slug][equals]', slug);
  url.searchParams.set('draft', 'true');
  url.searchParams.set('depth', '2');
  url.searchParams.set('limit', '1');
  const res = await fetch(url.toString(), {
    headers: apiKey ? { Authorization: `users API-Key ${apiKey}` } : {},
  });
  if (res.ok) {
    const data = await res.json();
    doc = data?.docs?.[0] ?? null;
  }
} catch {
  doc = null;
}

const metadata = {
  title: doc?.title ? `Preview — ${doc.title}` : 'Preview',
  robots: { index: false, follow: false },
};

const blocks = collection === 'pages' ? (doc?.layout ?? []) : [];
const postHtml = collection === 'posts' ? richTextToHtml(doc?.body) : '';
---

<SiteLayout metadata={metadata}>
  <div id="preview-root">
    {
      !doc ? (
        <section class="mx-auto max-w-3xl px-6 py-24 text-center">
          <h1 class="text-2xl font-bold">Nothing to preview</h1>
          <p class="mt-3 text-muted">
            No {collection} draft found for slug “{slug}”.
          </p>
        </section>
      ) : collection === 'pages' ? (
        <BlockRenderer blocks={blocks} />
      ) : (
        <article class="prose mx-auto max-w-3xl px-6 py-12 dark:prose-invert">
          <h1>{doc.title}</h1>
          {doc.excerpt ? <p class="text-lg text-muted">{doc.excerpt}</p> : null}
          <Fragment set:html={postHtml} />
        </article>
      )
    }
  </div>

  <div id="preview-meta" data-cms-origin={serverUrl} hidden></div>

  <script>
    import { subscribe, ready } from '@payloadcms/live-preview';

    const meta = document.getElementById('preview-meta');
    const serverURL = meta?.dataset.cmsOrigin ?? window.location.origin;

    let timer: ReturnType<typeof setTimeout> | undefined;

    // Autosave fires often; debounce a re-fetch of this same URL and swap the
    // rendered content so blocks/layout changes appear without a full reload.
    const refresh = () => {
      if (timer) clearTimeout(timer);
      timer = setTimeout(async () => {
        try {
          const res = await fetch(window.location.href, { headers: { Accept: 'text/html' } });
          if (!res.ok) return;
          const html = await res.text();
          const next = new DOMParser().parseFromString(html, 'text/html').querySelector('#preview-root');
          const current = document.querySelector('#preview-root');
          if (next && current) current.innerHTML = next.innerHTML;
        } catch {
          /* ignore transient fetch errors during rapid edits */
        }
      }, 250);
    };

    const unsubscribe = subscribe({ serverURL, callback: refresh, initialData: {}, depth: 2 });
    ready({ serverURL });
    window.addEventListener('beforeunload', () => unsubscribe());
  </script>
</SiteLayout>
