---
import type { Form } from '@siteforge/shared';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import PayloadForm from '~/components/payload/PayloadForm.astro';

interface Props {
  id?: string;
  isDark?: boolean;
  title?: string;
  subtitle?: string;
  tagline?: string;
  form?: Form | number | null;
}

const { id, isDark = false, title, subtitle, tagline, form } = Astro.props;

// In static builds the relationship is populated (depth >= 1); guard the case
// where it is only an id so the page still renders.
const resolvedForm = form && typeof form === 'object' ? form : null;
---

<WidgetWrapper id={id} isDark={isDark} containerClass="max-w-7xl mx-auto">
  {(title || subtitle || tagline) && <Headline title={title} subtitle={subtitle} tagline={tagline} />}

  {
    resolvedForm ? (
      <div class="mx-auto flex w-full max-w-xl flex-col rounded-lg border border-gray-200 bg-white p-4 shadow backdrop-blur dark:border-gray-700 dark:bg-slate-900 sm:p-6 lg:p-8">
        <PayloadForm form={resolvedForm} />
      </div>
    ) : (
      <p class="text-center text-sm text-muted">Form unavailable.</p>
    )
  }
</WidgetWrapper>
