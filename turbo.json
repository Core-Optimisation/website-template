{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URI",
    "PAYLOAD_SECRET",
    "PAYLOAD_PUBLIC_SERVER_URL",
    "WEB_PUBLIC_URL",
    "MEDIA_DIR",
    "RENDER_MODE",
    "DB_ADAPTER",
    "MEDIA_ADAPTER",
    "POSTGRES_URL",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "NODE_ENV"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "generate:types": {
      "cache": false
    },
    "generate:importmap": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
