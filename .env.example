# ─────────────────────────────────────────────────────────────────────────────
# SiteForge environment — copy to `.env` and fill in. One file drives both apps.
# ─────────────────────────────────────────────────────────────────────────────

# --- Secrets ----------------------------------------------------------------
# Long random string used by Payload to sign auth/JWT. CHANGE THIS.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- URLs -------------------------------------------------------------------
# Where the Payload CMS (admin + API) is served.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Where the public Astro site is served.
WEB_PUBLIC_URL=http://localhost:4321

# --- Live Preview -----------------------------------------------------------
# Shared secret that gates the Astro /preview route (must match on both sides).
PREVIEW_SECRET=change-me-to-a-random-preview-secret
# Payload API key used by /preview to read DRAFT content. Generate it from a
# user in the CMS admin (enable "API Key" on the user) and paste it here.
PAYLOAD_API_TOKEN=

# --- Database ---------------------------------------------------------------
# DB_ADAPTER selects the adapter with no code change: sqlite | postgres
DB_ADAPTER=sqlite
# SQLite (default, portable). The file is the backup unit.
DATABASE_URI=file:./siteforge.db
# Postgres (optional). Used only when DB_ADAPTER=postgres.
POSTGRES_URL=postgres://user:password@localhost:5432/siteforge

# --- Media ------------------------------------------------------------------
# MEDIA_ADAPTER selects the storage adapter: local | s3
MEDIA_ADAPTER=local
# Local disk upload dir (default, portable). The folder is the backup unit.
MEDIA_DIR=media
# S3 / S3-compatible (optional). Used only when MEDIA_ADAPTER=s3.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rendering --------------------------------------------------------------
# RENDER_MODE selects how the Astro site is built/served: static | ssr
#   static → pages pre-rendered at build over all published slugs
#   ssr    → Node adapter, fetched per request (enables draft preview)
RENDER_MODE=static
